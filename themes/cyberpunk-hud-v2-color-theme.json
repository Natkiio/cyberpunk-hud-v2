  "tokenColors": [
    {
      "name": "Comments",
      "scope": ["comment", "punctuation.definition.comment", "string.comment"],
      "settings": { "foreground": "#7d8787", "fontStyle": "italic" }
    },
    {
      "name": "Doc comment tags",
      "scope": ["comment storage.type", "comment keyword.codetag", "storage.type.class.jsdoc", "entity.name.type.instance.jsdoc"],
      "settings": { "foreground": "#5f9e95", "fontStyle": "" }
    },
    {
      "name": "Keywords / storage",
      "scope": ["keyword", "storage.type", "storage.modifier", "keyword.control", "keyword.other", "variable.language.this", "variable.language.self", "variable.language.super"],
      "settings": { "foreground": "#ff1f4b" }
    },
    {
      "name": "Operators",
      "scope": ["keyword.operator", "storage.type.function.arrow", "punctuation.separator.key-value"],
      "settings": { "foreground": "#ff4d6d" }
    },
    {
      "name": "Strings",
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "settings": { "foreground": "#a9f2e6" }
    },
    {
      "name": "String escapes / regex",
      "scope": ["constant.character.escape", "string.regexp", "constant.other.placeholder"],
      "settings": { "foreground": "#d4fff7" }
    },
    {
      "name": "Template interpolation",
      "scope": ["punctuation.definition.template-expression", "punctuation.section.embedded"],
      "settings": { "foreground": "#ff4d6d" }
    },
    {
      "name": "Numbers / constants",
      "scope": ["constant.numeric", "constant.language", "constant.other", "support.constant", "variable.other.constant", "variable.other.enummember"],
      "settings": { "foreground": "#ff4d6d" }
    },
    {
      "name": "Functions",
      "scope": ["entity.name.function", "support.function", "meta.function-call entity.name.function", "variable.function"],
      "settings": { "foreground": "#ffffff" }
    },
    {
      "name": "Types / classes",
      "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class", "storage.type.primitive", "entity.name.namespace"],
      "settings": { "foreground": "#5f9e95" }
    },
    {
      "name": "Variables",
      "scope": ["variable", "variable.other", "variable.other.readwrite", "meta.definition.variable"],
      "settings": { "foreground": "#e8eded" }
    },
    {
      "name": "Parameters",
      "scope": ["variable.parameter", "meta.parameters variable"],
      "settings": { "foreground": "#c4cccc", "fontStyle": "italic" }
    },
    {
      "name": "Properties",
      "scope": ["variable.other.property", "variable.other.object.property", "support.variable.property", "meta.object-literal.key", "entity.name.tag.yaml", "support.type.property-name"],
      "settings": { "foreground": "#c4cccc" }
    },
    {
      "name": "Punctuation",
      "scope": ["punctuation", "meta.brace", "punctuation.separator", "punctuation.terminator", "punctuation.accessor"],
      "settings": { "foreground": "#8f9898" }
    },
    {
      "name": "Decorators / annotations",
      "scope": ["meta.decorator", "punctuation.decorator", "storage.type.annotation", "entity.name.function.decorator"],
      "settings": { "foreground": "#ff4d6d", "fontStyle": "italic" }
    },
    {
      "name": "HTML / Svelte tags",
      "scope": ["entity.name.tag", "punctuation.definition.tag", "support.class.component"],
      "settings": { "foreground": "#ff1f4b" }
    },
    {
      "name": "Tag attributes",
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#5f9e95" }
    },
    {
      "name": "CSS selectors",
      "scope": ["entity.other.attribute-name.class.css", "entity.other.attribute-name.id.css", "entity.name.tag.css", "entity.other.attribute-name.pseudo-class.css"],
      "settings": { "foreground": "#ff4d6d" }
    },
    {
      "name": "CSS properties",
      "scope": ["support.type.property-name.css", "variable.css", "variable.argument.css"],
      "settings": { "foreground": "#c4cccc" }
    },
    {
      "name": "CSS values / units",
      "scope": ["support.constant.property-value.css", "keyword.other.unit", "constant.other.color"],
      "settings": { "foreground": "#a9f2e6" }
    },
    {
      "name": "JSON keys",
      "scope": ["support.type.property-name.json"],
      "settings": { "foreground": "#c4cccc" }
    },
    {
      "name": "Invalid",
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#ffffff", "background": "#ff1f4b" }
    },

    {
      "name": "Markdown H1 — red HUD banner",
      "scope": ["markup.heading.1.markdown", "heading.1.markdown entity.name.section", "markup.heading.setext.1"],
      "settings": { "foreground": "#ff1f4b", "fontStyle": "bold" }
    },
    {
      "name": "Markdown other headings",
      "scope": ["markup.heading", "entity.name.section.markdown", "markup.heading.setext"],
      "settings": { "foreground": "#c4cccc", "fontStyle": "bold" }
    },
    {
      "name": "Markdown heading hashes",
      "scope": ["punctuation.definition.heading.markdown"],
      "settings": { "foreground": "#7a1428" }
    },
    {
      "name": "Markdown bold",
      "scope": ["markup.bold"],
      "settings": { "foreground": "#ffffff", "fontStyle": "bold" }
    },
    {
      "name": "Markdown italic",
      "scope": ["markup.italic"],
      "settings": { "foreground": "#a9f2e6", "fontStyle": "italic" }
    },
    {
      "name": "Markdown strikethrough",
      "scope": ["markup.strikethrough"],
      "settings": { "foreground": "#7d8787", "fontStyle": "strikethrough" }
    },
    {
      "name": "Markdown code",
      "scope": ["markup.inline.raw", "markup.fenced_code", "markup.raw"],
      "settings": { "foreground": "#a9f2e6" }
    },
    {
      "name": "Markdown fence language",
      "scope": ["fenced_code.block.language"],
      "settings": { "foreground": "#7d8787" }
    },
    {
      "name": "Markdown links",
      "scope": ["markup.underline.link", "string.other.link", "meta.link"],
      "settings": { "foreground": "#ff4d6d" }
    },
    {
      "name": "Markdown list markers",
      "scope": ["punctuation.definition.list.begin.markdown", "beginning.punctuation.definition.list.markdown"],
      "settings": { "foreground": "#ff1f4b" }
    },
    {
      "name": "Markdown blockquote",
      "scope": ["markup.quote", "punctuation.definition.quote.begin.markdown"],
      "settings": { "foreground": "#c4cccc", "fontStyle": "italic" }
    },
    {
      "name": "Markdown hr / tables",
      "scope": ["meta.separator.markdown", "punctuation.definition.table.markdown"],
      "settings": { "foreground": "#3c4444" }
    },
    {
      "name": "Diff",
      "scope": ["markup.inserted"],
      "settings": { "foreground": "#a9f2e6" }
    },
    {
      "scope": ["markup.deleted"],
      "settings": { "foreground": "#ff1f4b" }
    },
    {
      "scope": ["markup.changed"],
      "settings": { "foreground": "#c4cccc" }
    }
  ],
